# Include inside your existing HTTPS server block, after configuring TLS.
# Replace this example domain and filesystem path for your installation.
location = /studio { return 301 /studio/; }
location /studio/wiki/ {
    auth_request /_studio_auth;
    error_page 401 = @studio_login;
    alias /srv/zhihu-ai-studio/site/wiki/;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
}
location = /_studio_auth {
    internal;
    proxy_pass http://127.0.0.1:27821/api/auth/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
}
location /studio/ {
    proxy_pass http://127.0.0.1:27821/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 1800s;
    client_max_body_size 24m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
}

location @studio_login {
    return 302 /studio/login/?next=/studio/wiki/;
}
